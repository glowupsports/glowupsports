    "transactionB": {
      "name": "CANONICAL_APPLICATION",
      "precondition": "Decision status is ACCEPTED.",
      "steps": [
        "Lock player_canonical_progression FOR UPDATE.",
        "Verify expected state version.",
        "Revalidate actor/scope, immutable config availability, evidence eligibility, contribution idempotency, and application receipt absence.",
        "Apply component-weighted canonical skill state.",
        "Derive family, pillar, Glow, readiness, and aggregate fields.",
        "Persist immutable history, snapshots, contribution rows, and application receipt.",
        "Increment player state version.",
        "Set DevelopmentDecision to APPLIED.",
        "Commit atomically."
      ],
      "success": "Decision is APPLIED and one application receipt exists."
    },
    "technicalFailure": {
      "rule": "Roll back Transaction B completely. The decision remains ACCEPTED.",
      "attemptPersistence": "In a separate transaction insert immutable development_decision_execution_attempt with outcome TECHNICAL_FAILURE, failure_class, stable error_code, diagnostic_reference, attempt_number, expected_state_version, observed_state_version, and timestamps.",
      "retry": "The same ACCEPTED decision may retry if expected state version, config versions, and evidence eligibility remain valid."
    },
    "staleState": {
      "rule": "If locked state_version differs from expected_player_state_version, perform no canonical mutation; insert immutable execution attempt outcome STALE_STATE_VERSION and return that result.",
      "resolution": "Require reassessment or revalidation under policy; do not silently replay the old judgement against new state."
    },
    "executionAttempt": {
      "table": "development_decision_execution_attempt",
      "unique": [
        "decision_id",
        "attempt_number"
      ],
      "outcomes": [
        "APPLIED",
        "TECHNICAL_FAILURE",
        "STALE_STATE_VERSION",
        "CONFIG_INVALID",
        "EVIDENCE_INELIGIBLE",
        "AUTH_REVALIDATION_FAILED"
      ],
